# ssh - real SSH, via libssh bound into the native interpreter (not a
# from-scratch reimplementation - real SSH key exchange needs big-integer/
# elliptic-curve math Larzscript's double-only numeric type can't honestly
# do, the same reason `crypto` doesn't implement X25519/Ed25519). This
# talks to real sshd/OpenSSH/dropbear, no shelling out to the `ssh` binary.
#
# Phase 1: client only, and only where libssh is actually linked (see this
# package's README for exactly which platforms - NOT all of them yet).
# Where it isn't linked, every function below throws a clear SshError
# instead of "unknown identifier" - check for that if you're unsure your
# platform is covered yet.
#
#   larzscript pkg install ssh
#
#   import "ssh" as ssh
#   let session = ssh.connect("myserver.com", 22)
#   ssh.authenticate_with_password(session, "root", "hunter2")
#   let result = ssh.run(session, "whoami")
#   print(result["stdout"])
#   ssh.disconnect(session)

# timeout_seconds: how long to wait for the TCP connect + SSH banner/key
# exchange before giving up (default 15s) - fails fast on an unreachable
# or silently-firewalled relay instead of hanging on libssh's own,
# usually much longer, internal default. Found wanting during a real
# live test against a relay that occasionally stopped responding.
fn connect(host, port, timeout_seconds=15) { return ssh_open(host, port, timeout_seconds) }

fn authenticate_with_password(session, user, password) { ssh_auth_password(session, user, password) }

fn authenticate_with_key(session, user, key_path) { ssh_auth_key(session, user, key_path) }

# Host-key verification (client side) - checks the connected server's
# key against `known_hosts_path`, using libssh's own known_hosts
# implementation (not hand-rolled). Call this AFTER connect() (the key
# exchange already happened by then) and BEFORE any authenticate_*()
# call. Returns one of: "ok" (matches a known entry), "changed" (the
# key is DIFFERENT from what's on record for this host - the real
# MITM-detection case, never silently proceed on this one), "unknown"
# (host isn't in the file yet - normal on first connect), "not_found"
# (no known_hosts file yet), "other" (host known, but not with this key
# type), "error".
fn check_host(session, known_hosts_path) { return ssh_check_host(session, known_hosts_path) }

# Records the server's CURRENT key into known_hosts (creating the
# file/directory if it doesn't exist). Only call this once YOU'VE
# decided it's safe - e.g. after showing the user a fingerprint to
# confirm, or as a deliberate trust-on-first-use policy. Never call this
# on a "changed" result - see verify_host_trust_on_first_use() below for
# the common convenience case that gets this right automatically.
fn trust_host(session, known_hosts_path) { ssh_trust_host(session, known_hosts_path) }

# Convenience wrapper for the common case (a relay/server you just set
# up, no separate side-channel to verify a fingerprint against): trusts
# the key the FIRST time it's seen, and fails closed - throws, never
# silently proceeds - the moment a previously-trusted key changes. NOT a
# substitute for real out-of-band verification against a host you don't
# control; for that, call check_host()/trust_host() directly and show
# the user a real prompt instead of auto-trusting.
fn verify_host_trust_on_first_use(session, known_hosts_path) {
  let status = ssh_check_host(session, known_hosts_path)
  if status == "changed" {
    throw {"type": "SshHostKeyError", "message": "host key for this server has CHANGED since it was last recorded in " + known_hosts_path + " - refusing to connect (possible MITM). Only remove the stale entry if you're SURE this is expected (e.g. the server was rebuilt)."}
  }
  if status == "unknown" or status == "not_found" {
    ssh_trust_host(session, known_hosts_path)
  }
  return status
}

# Runs `cmd` on the remote host and waits for it to finish. Returns
# {"stdout": ..., "stderr": ..., "exit_status": ...} - the command's real
# output and real exit code, not just whether the SSH request itself
# succeeded.
fn run(session, cmd) { return ssh_run(session, cmd) }

fn disconnect(session) { ssh_close(session) }

# The real `ssh -R` equivalent: asks the connected server to listen on
# `remote_port` and forward every connection it gets there back to
# `target_host:target_port` on THIS machine - no custom protocol, this is
# real SSH channel forwarding through a real sshd, exactly what netbridge
# achieves by shelling out to `ssh -R`.
#
# Blocks forever. One active forwarded connection at a time (matches the
# `tcp` package's own "not concurrent" precedent) - a second incoming
# connection waits until the first one closes.
#
# The actual byte-shuttling (connect to target_host:target_port, then
# bridge every byte both ways until either side closes) happens entirely
# in C via ssh_bridge_forward() - not a Larzscript-level read/write loop.
# That used to be the case, and it had a real, confirmed bug: forwarded
# data passed through Larzscript string values, which have no stored
# length (just a char* that's always NUL-terminated - see native/
# larzscript.c's Value/Str) - any real 0x00 byte in the forwarded traffic
# was silently truncated. Fine for the toy demos, but a real SSH session
# tunneled through here (SSH's own wire protocol is binary, and 0x00
# bytes show up routinely in real handshake packets) got its banner
# through fine, then the very next binary KEX packet got truncated
# mid-packet, corrupting the handshake and killing the connection -
# caught via an actual live end-to-end test, not a hunch. Fixed by moving
# the whole bridge into C, using raw buffers and real byte counts the
# same way ssh_channel_shell() already had to for the interactive-shell
# case. This also removed the old `import "tcp"` dependency this
# function used to have (ssh_bridge_forward() dials the TCP target
# itself) - one less thing to install.
fn forward_remote_port(session, remote_port, target_host, target_port, opts={}) {
  let log = opts.has("log_fn") ? opts["log_fn"] : fn(line) { print(line) }
  ssh_listen_forward(session, remote_port)
  log("ssh: listening on the relay's port " + str(remote_port) + " -> " + target_host + ":" + str(target_port))
  while true {
    let channel = ssh_accept_forward(session, 1000)
    if channel == nil { continue }
    log("ssh: forwarded connection accepted, bridging")
    # Wrapped: without this, any error during one connection's lifetime
    # (the target refusing a connection, a socket/channel error)
    # propagated all the way out of this function and killed the WHOLE
    # tunnel - not just that one connection - taking the real ssh session
    # (and the relay's remote-forward listener with it) down. Found via a
    # real live test against a real relay, not assumed.
    try {
      ssh_bridge_forward(channel, target_host, target_port)
    } catch e {
      log("ssh: forwarded connection error: " + str(e))
    }
    ssh_channel_free(channel)
    log("ssh: forwarded connection closed")
  }
}

# ==================== server role ====================
#
# A real SSH server - this machine answers `ssh user@this-machine cmd`
# with real command output, AND `ssh user@this-machine` (no command) with
# a real interactive login shell - a real pty, real job control, resizes
# correctly - no OpenSSH/dropbear/anything external installed on this
# machine either way. v1 scope: password auth only (no server-side
# pubkey checking yet). One connection at a time, matching the `tcp`
# package's own precedent. Interactive shell is POSIX only (Linux,
# macOS) - Windows has no fork()/pty; a real ConPTY-based equivalent
# isn't built yet, so a Windows server still answers exec commands fine
# but denies shell requests (see native/larzscript.c's LARZ_HAVE_PTY).
#
# Generates a host key on first use if `host_key_path` doesn't exist yet
# - same as any real sshd needs one.

fn listen(port, host_key_path) {
  if not file_exists(host_key_path) {
    # capture(), not run(): this package's own run(session, cmd) function
    # (below) shadows the global run() shell builtin for any unqualified
    # call from within this file - found via a real test, not assumed.
    # capture() isn't shadowed by anything here.
    capture("ssh-keygen -t ed25519 -f " + host_key_path + " -N '' -q")
  }
  return ssh_bind_open(port, host_key_path)
}

# Runs forever: accepts one client at a time, authenticates it via
# `check_password(user, password) -> bool`. For each command it execs,
# calls `run_command(cmd) -> string` and sends that back as the
# command's real output (exit status always 0 for v1 - the caller's
# run_command is responsible for encoding failure into its own output if
# it wants to; a future version could let run_command return a
# {"output":, "exit_status":} dict instead). For an interactive login
# (no command - `ssh user@host`), spawns a real shell attached to a real
# pty (see ssh_channel_shell() in native/larzscript.c) - pass
# `opts["allow_shell"] = false` to disable this and answer exec commands
# only (matches the old v1 exec-only behavior).
fn serve(bind, check_password, run_command, opts={}) {
  let log = opts.has("log_fn") ? opts["log_fn"] : fn(line) { print(line) }
  let allow_shell = opts.has("allow_shell") ? opts["allow_shell"] : true
  while true {
    let session = nil
    try {
      session = ssh_bind_accept_session(bind)
    } catch e {
      log("ssh server: accept failed: " + str(e))
      continue
    }
    log("ssh server: client connected")
    try {
      _serve_session(session, check_password, run_command, allow_shell, log)
    } catch e {
      log("ssh server: session ended: " + str(e))
    }
    ssh_close(session)
  }
}

fn _serve_session(session, check_password, run_command, allow_shell, log) {
  let authenticated = false
  let channel = nil
  let pty_cols = 80
  let pty_rows = 24
  while true {
    let msg = ssh_server_next_message(session)
    if msg == nil { return }
    let t = ssh_msg_type(msg)
    if t == "auth_password" {
      let user = ssh_msg_auth_user(msg)
      let password = ssh_msg_auth_password(msg)
      if check_password(user, password) {
        authenticated = true
        ssh_msg_auth_accept(msg)
        log("ssh server: " + user + " authenticated")
      } else {
        ssh_msg_deny(msg)
      }
    } else if t == "channel_open" {
      if not authenticated { ssh_msg_deny(msg) } else { channel = ssh_msg_channel_accept(msg) }
    } else if t == "pty" {
      if not authenticated or not allow_shell {
        ssh_msg_deny(msg)
      } else {
        # Client's requested terminal size - read BEFORE accepting, so a
        # follow-up "shell" request sizes the pty right from the start
        # instead of starting at a default and needing a manual resize.
        pty_cols = ssh_msg_pty_width(msg)
        pty_rows = ssh_msg_pty_height(msg)
        ssh_msg_request_accept(msg)
      }
    } else if t == "shell" {
      if not authenticated or not allow_shell {
        ssh_msg_deny(msg)
      } else {
        let ch = ssh_msg_channel(msg)
        ssh_msg_request_accept(msg)
        log("ssh server: interactive shell requested (" + str(pty_cols) + "x" + str(pty_rows) + ")")
        # Wrapped: ssh_channel_shell() throws on platforms without pty
        # support (Windows - no fork()/ConPTY yet, see the file header
        # above). Without this, that error would propagate out of the
        # whole session (killing exec too, on the SAME connection) rather
        # than just failing the one shell request - same reasoning
        # forward_remote_port()'s own try/catch documents.
        try {
          let exit_code = ssh_channel_shell(ch, pty_cols, pty_rows)
          ssh_channel_send_exit_status(ch, exit_code)
        } catch e {
          log("ssh server: interactive shell failed: " + str(e))
          ssh_channel_write(ch, "no interactive shell available on this server (" + str(e) + ") - try running a single command instead\n")
          ssh_channel_send_exit_status(ch, 1)
        }
        ssh_channel_close(ch)
        ssh_channel_free(ch)
      }
    } else if t == "exec" {
      let cmd = ssh_msg_exec_command(msg)
      let ch = ssh_msg_channel(msg)
      ssh_msg_request_accept(msg)
      log("ssh server: exec " + cmd)
      let output = run_command(cmd)
      ssh_channel_write(ch, output)
      ssh_channel_send_exit_status(ch, 0)
      ssh_channel_close(ch)
      ssh_channel_free(ch)
    } else {
      ssh_msg_deny(msg)
    }
  }
}
