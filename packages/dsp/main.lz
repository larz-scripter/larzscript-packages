# dsp - real, from-scratch audio signal processing: sin/cos/exp/ln (none
# are builtins - `pow()` only takes whole-number exponents, same
# constraint the `orbits` package works around), a biquad peaking/
# shelving EQ (the real RBJ Audio EQ Cookbook formulas), a look-up-table
# compressor (the transfer curve is precomputed once via the slow-but-
# exact log/exp above, so the per-sample hot loop is pure array indexing,
# not a log() call per sample - the standard real-DSP technique for this
# exact problem), a brickwall limiter, and peak/RMS/normalize helpers.
# Every filter's state is a plain dict the caller owns and threads through
# calls (same convention as the `ratelimit` package) - no hidden globals,
# so multiple independent filters/tracks never interfere.
#
#   import "dsp" as dsp
#   let eq = dsp.biquad_peaking_new(1000, 6, 1.0, 22050)   # +6dB @ 1kHz
#   let y = dsp.biquad_process(eq, x)                       # per sample
#
#   let comp = dsp.compressor_new(-18, 4, 5, 80, 22050)     # -18dB, 4:1
#   let compressed = dsp.compressor_process_buffer(comp, buffer)
#
#   let limited = dsp.limit(buffer, -1.0)                   # ceiling, dBFS
#   print(dsp.peak_dbfs(buffer), dsp.rms_dbfs(buffer))
#   let normalized = dsp.normalize_to(buffer, -3.0)

import "random" as rng

let PI = 3.141592653589793
let LN10 = 2.302585092994046
let E = 2.718281828459045
let LN2 = 0.6931471805599453

# ---- sin/cos/exp/ln - none are builtins (see orbits' own ln() for the
# same constraint). Range-reduced Taylor series; accurate to ~1e-6 over
# a full period, plenty for filter-coefficient and dB-conversion math. ----

fn _exp(y) {
  let whole = int(y)
  if y < 0 and whole != y { whole = whole - 1 }
  let frac = y - whole
  let base = 1.0
  let k = 0
  while k < (whole < 0 ? -whole : whole) {
    base = whole < 0 ? base / E : base * E
    k = k + 1
  }
  let term = 1.0
  let total = 1.0
  let n = 1
  while n < 30 { term = term * frac / n; total = total + term; n = n + 1 }
  return base * total
}

fn _ln(x) {
  if x <= 0 { throw {"type": "LarzValueError", "message": "ln() needs a positive number"} }
  # Range-reduce to v in [1, 2) (tracking the power of 2 removed as k),
  # then the fast-converging atanh series ln(v) = 2*atanh(z),
  # z = (v-1)/(v+1) - z stays in [0, 1/3) here, so ~10 terms already hits
  # double precision. (A prior version bisected against _exp() 100 times
  # per call - fine in isolation, but catastrophic at LUT-build volume:
  # compressor_new()'s 4096-entry table alone took ~55s. This is the same
  # cost class as sqrt()'s Newton's-method loop below, not a special case.)
  let k = 0
  let v = x
  while v >= 2.0 { v = v / 2.0; k = k + 1 }
  while v < 1.0 { v = v * 2.0; k = k - 1 }
  let z = (v - 1) / (v + 1)
  let z2 = z * z
  let term = z
  let total = 0.0
  let n = 1
  while n <= 19 {
    total = total + term / n
    term = term * z2
    n = n + 2
  }
  return 2 * total + k * LN2
}

# `%` truncates both sides to integers first (Larzscript has no float
# fmod builtin) - not usable here, x is a phase in radians. This is a
# real float-safe modulo via floor division instead.
fn _fmod(x, m) {
  let q = x / m
  let qf = floor(q)
  return x - qf * m
}

fn sin_(x) {
  let y = _fmod(x, 2 * PI)
  if y > PI { y = y - 2 * PI }
  if y < -PI { y = y + 2 * PI }
  let y2 = y * y
  # 4-term reduced Taylor/Horner form - accurate to ~1e-6 on [-pi, pi].
  return y * (1 - y2 / 6 * (1 - y2 / 20 * (1 - y2 / 42 * (1 - y2 / 72))))
}

fn cos_(x) { return sin_(x + PI / 2) }

fn db_to_linear(db) { return _exp(db / 20 * LN10) }
fn linear_to_db(x) { return x <= 0 ? -120.0 : _ln(x) / LN10 * 20 }

# ---- biquad EQ: RBJ Audio EQ Cookbook peaking and shelving filters.
# `new_*` computes the coefficients once; `process` runs the per-sample
# recurrence (2 multiplies-and-adds of history - cheap, called once per
# sample, unlike coefficient setup which uses the slow sin_/_exp above). ----

fn biquad_peaking_new(freq_hz, gain_db, q, sample_rate) {
  let a = db_to_linear(gain_db / 2)
  let w0 = 2 * PI * freq_hz / sample_rate
  let alpha = sin_(w0) / (2 * q)
  let cw0 = cos_(w0)
  let b0 = 1 + alpha * a
  let b1 = -2 * cw0
  let b2 = 1 - alpha * a
  let a0 = 1 + alpha / a
  let a1 = -2 * cw0
  let a2 = 1 - alpha / a
  return {"b0": b0 / a0, "b1": b1 / a0, "b2": b2 / a0, "a1": a1 / a0, "a2": a2 / a0,
          "x1": 0.0, "x2": 0.0, "y1": 0.0, "y2": 0.0}
}

# Low-shelf (boost/cut everything below freq_hz) or high-shelf (above).
fn biquad_shelf_new(freq_hz, gain_db, sample_rate, high) {
  let a = db_to_linear(gain_db / 2)
  let w0 = 2 * PI * freq_hz / sample_rate
  let cw0 = cos_(w0)
  let sw0 = sin_(w0)
  let alpha = sw0 / 2 * sqrt((a + 1 / a) * (1 / 0.9 - 1) + 2)
  let sq = 2 * sqrt(a) * alpha
  let b0 = 0.0
  let b1 = 0.0
  let b2 = 0.0
  let a0 = 0.0
  let a1 = 0.0
  let a2 = 0.0
  if high {
    b0 = a * ((a + 1) + (a - 1) * cw0 + sq)
    b1 = -2 * a * ((a - 1) + (a + 1) * cw0)
    b2 = a * ((a + 1) + (a - 1) * cw0 - sq)
    a0 = (a + 1) - (a - 1) * cw0 + sq
    a1 = 2 * ((a - 1) - (a + 1) * cw0)
    a2 = (a + 1) - (a - 1) * cw0 - sq
  } else {
    b0 = a * ((a + 1) - (a - 1) * cw0 + sq)
    b1 = 2 * a * ((a - 1) - (a + 1) * cw0)
    b2 = a * ((a + 1) - (a - 1) * cw0 - sq)
    a0 = (a + 1) + (a - 1) * cw0 + sq
    a1 = -2 * ((a - 1) + (a + 1) * cw0)
    a2 = (a + 1) + (a - 1) * cw0 - sq
  }
  return {"b0": b0 / a0, "b1": b1 / a0, "b2": b2 / a0, "a1": a1 / a0, "a2": a2 / a0,
          "x1": 0.0, "x2": 0.0, "y1": 0.0, "y2": 0.0}
}

# Constant 0dB-peak-gain bandpass (RBJ Audio EQ Cookbook) - isolates a
# narrow band around freq_hz (bandwidth set by q) instead of shelving
# everything above/below it. Used as a detector filter (de-essing,
# sidechain ducking) - process a copy through this to measure how much
# energy is in one band, without altering the signal that copy came from.
fn biquad_bandpass_new(freq_hz, q, sample_rate) {
  let w0 = 2 * PI * freq_hz / sample_rate
  let cw0 = cos_(w0)
  let sw0 = sin_(w0)
  let alpha = sw0 / (2 * q)
  let b0 = alpha
  let b1 = 0.0
  let b2 = -alpha
  let a0 = 1 + alpha
  let a1 = -2 * cw0
  let a2 = 1 - alpha
  return {"b0": b0 / a0, "b1": b1 / a0, "b2": b2 / a0, "a1": a1 / a0, "a2": a2 / a0,
          "x1": 0.0, "x2": 0.0, "y1": 0.0, "y2": 0.0}
}

fn biquad_process(f, x) {
  let y = f["b0"] * x + f["b1"] * f["x1"] + f["b2"] * f["x2"] - f["a1"] * f["y1"] - f["a2"] * f["y2"]
  f["x2"] = f["x1"]; f["x1"] = x
  f["y2"] = f["y1"]; f["y1"] = y
  return y
}

# A pure-Larzscript per-sample loop here costs tens of microseconds per
# call at this interpreter's per-call overhead - fine for one-off use,
# but multiplied over a real multi-minute master (several filters x
# hundreds of thousands of samples) that's minutes of render time. The
# interpreter exposes a native accelerator with the exact same math and
# filter-dict contract as biquad_process() above (same RBJ difference
# equation, same field names, mutates the same history fields) - this
# just runs it as one tight C loop instead of one function call per
# sample. biquad_process() itself is unchanged and still the right tool
# for one sample at a time.
fn biquad_process_buffer(f, buf) {
  return _native_biquad_process_buffer(f, buf)
}

# ---- compressor: threshold/ratio in dB, attack/release in ms. Builds a
# 4096-point linear-envelope -> gain lookup table ONCE (using the slow
# _ln/_exp above), so the per-sample hot loop is index + multiply, not a
# log() call per sample. ----

let _LUT_SIZE = 4096
let _LUT_MAX_LINEAR = 4.0   # covers up to +12dBFS of headroom

fn compressor_new(threshold_db, ratio, attack_ms, release_ms, sample_rate) {
  let lut = []
  let i = 0
  while i < _LUT_SIZE {
    let env_linear = (i / float(_LUT_SIZE)) * _LUT_MAX_LINEAR
    let gain = 1.0
    if env_linear > 0 {
      let in_db = linear_to_db(env_linear)
      let out_db = in_db > threshold_db ? threshold_db + (in_db - threshold_db) / ratio : in_db
      gain = db_to_linear(out_db - in_db)
    }
    lut.push(gain)
    i = i + 1
  }
  let attack_coeff = _exp(-1.0 / ((attack_ms / 1000.0) * sample_rate))
  let release_coeff = _exp(-1.0 / ((release_ms / 1000.0) * sample_rate))
  return {"lut": lut, "attack": attack_coeff, "release": release_coeff, "env": 0.0}
}

fn _lut_lookup(lut, env_linear) {
  let idx = int((env_linear / _LUT_MAX_LINEAR) * _LUT_SIZE)
  if idx < 0 { idx = 0 }
  if idx >= _LUT_SIZE { idx = _LUT_SIZE - 1 }
  return lut[idx]
}

# Updates the envelope from `level` and returns the gain for it, without
# tying that gain to one specific sample - the building block for a
# LINKED stereo compressor (feed it max(|L|, |R|) once per frame, apply
# the one returned gain to both channels, so the stereo image doesn't
# wobble the way independently-compressed L/R would).
fn compressor_gain(c, level) {
  let coeff = level > c["env"] ? c["attack"] : c["release"]
  c["env"] = c["env"] * coeff + level * (1 - coeff)
  return _lut_lookup(c["lut"], c["env"])
}

fn compressor_process(c, x) {
  let level = x < 0 ? -x : x
  let gain = compressor_gain(c, level)
  return x * gain
}

# Same rationale as biquad_process_buffer() above - native envelope
# follower + LUT-gain loop, same compressor-dict contract. lut_size/
# lut_max_linear are passed through explicitly so the native side can
# never drift from the constants that actually built the LUT.
fn compressor_process_buffer(c, buf) {
  return _native_compressor_process_buffer(c, buf, _LUT_SIZE, _LUT_MAX_LINEAR)
}

# ---- noise gate: same dict shape and LUT machinery as the compressor
# above (lut/attack/release/env), just built with the OPPOSITE transfer
# curve - unity gain above threshold_db, ratio'd down toward
# -reduction_db below it, instead of compressing above a threshold. This
# is why it can reuse compressor_process_buffer/_native_compressor_
# process_buffer as-is: the native side only ever reads the dict's lut/
# attack/release/env fields, it doesn't care what curve built the lut. ----
fn gate_new(threshold_db, reduction_db, attack_ms, release_ms, sample_rate) {
  let lut = []
  let i = 0
  while i < _LUT_SIZE {
    let env_linear = (i / float(_LUT_SIZE)) * _LUT_MAX_LINEAR
    let gain = 1.0
    if env_linear > 0 {
      let in_db = linear_to_db(env_linear)
      if in_db < threshold_db {
        # Linearly ramp the reduction from 0 right at the threshold down
        # to the full -reduction_db a further 20dB below it, instead of
        # slamming straight to -reduction_db the instant level dips under
        # threshold_db - a hard on/off gate audibly chatters on breathy
        # material; this ramp is what keeps it sounding like "the room
        # noise got quieter," not a switch flipping.
        let below = threshold_db - in_db
        let frac = below / 20.0
        if frac > 1.0 { frac = 1.0 }
        gain = db_to_linear(-reduction_db * frac)
      }
    }
    lut.push(gain)
    i = i + 1
  }
  let attack_coeff = _exp(-1.0 / ((attack_ms / 1000.0) * sample_rate))
  let release_coeff = _exp(-1.0 / ((release_ms / 1000.0) * sample_rate))
  return {"lut": lut, "attack": attack_coeff, "release": release_coeff, "env": 0.0}
}

# ---- sidechain processing: the gain applied to `signal` is computed from
# a SEPARATE `detector` buffer's level, not signal's own - the building
# block both a de-esser (detector = a bandpass-filtered copy honed in on
# the sibilant band, signal = the actual dry vocal) and sidechain ducking
# (detector = the vocal, signal = the beat) are made from. Same lut/
# attack/release/env dict shape as compressor_new/gate_new - any of the
# three constructors work here, only the transfer curve differs. ----
fn sidechain_process_buffer(c, detector, signal) {
  return _native_sidechain_process_buffer(c, detector, signal, _LUT_SIZE, _LUT_MAX_LINEAR)
}

# ---- fades + trim detection ----

# Linear gain ramp from start_gain to end_gain across the whole buffer -
# the standard way to fade a clip in/out without a click at the boundary.
fn fade_buffer(buf, start_gain, end_gain) {
  return _native_fade_buffer(buf, start_gain, end_gain)
}

# Index of the first sample whose absolute value crosses threshold_linear,
# or len(buf) if the whole buffer stays under it (silent throughout) -
# the building block for auto-trimming leading silence off a recording.
fn find_first_above(buf, threshold_linear) {
  return _native_find_first_above(buf, threshold_linear)
}

# ---- limiter: a true brickwall is just a linear clamp to the ceiling -
# infinite ratio needs no log/LUT at all, unlike the compressor above. ----

# limit/peak_dbfs/rms_dbfs/normalize_to below are one-op-per-sample
# passes (a clamp, a max, a sum of squares, a scale) - nothing
# algorithmically interesting, but several such passes over a whole
# multi-minute track add up the same way the filter/compressor chain
# above did, so the actual per-sample sweep runs natively; the dB<->linear
# conversion and the resulting scalar (ceiling/peak/gain) stay here.
fn limit(buf, ceiling_db) {
  return _native_limit_buffer(buf, db_to_linear(ceiling_db))
}

# ---- level metering + normalization ----

fn peak_dbfs(buf) {
  return linear_to_db(_native_peak_abs(buf))
}

fn rms_dbfs(buf) {
  if len(buf) == 0 { return -120.0 }
  return linear_to_db(sqrt(_native_sum_sq(buf) / len(buf)))
}

fn normalize_to(buf, target_dbfs) {
  let peak = db_to_linear(peak_dbfs(buf))
  if peak <= 0 { return list(buf) }
  let target = db_to_linear(target_dbfs)
  let g = target / peak
  return _native_scale_buffer(buf, g)
}

# ---- Phase F polish: saturation, stereo widening, delay/echo send.
# All three are native (_native_saturate_buffer/_native_stereo_widen/
# _native_delay_process_buffer) for the same reason biquad_process_buffer
# above is - a whole multi-minute render running these per-sample in
# interpreted Larzscript costs real seconds-to-minutes. ----

# Harmonic saturation / soft-clip - tanh-style waveshaping for
# analog-style warmth. drive > 0; higher = more of the curve's bend used
# (more perceived saturation), not more output level (the native side
# normalizes by tanh(drive) so +/-1.0 in stays roughly +/-1.0 out).
fn saturate_buffer(buf, drive) {
  return _native_saturate_buffer(buf, drive)
}

# Stereo widening via mid-side processing. width=1.0 unchanged, >1 wider,
# <1 narrower, 0 fully mono. Returns {"l":..., "r":...} (both same length
# as the inputs) rather than mutating in place.
fn stereo_widen(l, r, width) {
  return _native_stereo_widen(l, r, width)
}

# A feedback delay line ("echo") - state is a plain dict the caller owns
# and threads through calls, same convention every filter/compressor
# above already uses. delay_ms/feedback/mix are the whole interface:
# feedback controls how many repeats are audible before they decay away,
# mix is the wet level summed with the (always-passed-through) dry
# signal - 0 mix means no audible effect at all, not silence.
fn delay_new(delay_ms, feedback, mix, sample_rate) {
  let n = int(delay_ms / 1000.0 * sample_rate)
  if n < 1 { n = 1 }
  return {"line": [0.0] * n, "pos": 0.0, "feedback": feedback, "mix": mix}
}

fn delay_process_buffer(state, buf) {
  return _native_delay_process_buffer(state, buf)
}

# A real, simplified algorithmic reverb (larzscript-beatstudio PLAN4.md
# Phase K) - 4 parallel comb filters built directly on delay_new/
# delay_process_buffer above (no new native code needed - the existing
# feedback delay line already IS a comb filter, just built for a single
# echo tap). Delay times (29.7/37.1/41.1/43.7ms) are deliberately
# mutually-irrational-ish, not round numbers or simple multiples of each
# other - the classic Schroeder/Freeverb trick for avoiding a metallic/
# resonant "comb" artifact from delays that share common factors. A
# real, disclosed simplification vs. a full Freeverb: no per-comb
# damping (low-pass in the feedback path) or allpass diffusion stage -
# still 4 genuinely different, overlapping decay tails (a real reverb
# character), not a single echo repeated.
fn reverb_new(feedback, mix, sample_rate) {
  let delays_ms = [29.7, 37.1, 41.1, 43.7]
  let combs = []
  for ms in delays_ms { combs.push(delay_new(ms, feedback, 1.0, sample_rate)) }
  return {"combs": combs, "mix": mix}
}

# delay_process_buffer's own contract returns dry+wet (x[i]+delayed*mix) -
# each comb here is built with mix=1.0 internally (see reverb_new), so
# subtracting the input recovers that comb's pure wet tap; summing the 4
# recovered wet signals and mixing ONE copy of dry back in avoids
# quadruple-counting the dry signal the way naively summing 4 raw
# delay_process_buffer outputs would.
fn reverb_process_buffer(state, buf) {
  let n = len(buf)
  let wet_sum = [0.0] * n
  for comb in state["combs"] {
    let out = delay_process_buffer(comb, buf)
    let i = 0
    while i < n { wet_sum[i] = wet_sum[i] + (out[i] - buf[i]); i = i + 1 }
  }
  let ncombs = float(len(state["combs"]))
  let mix = state["mix"]
  let result = [0.0] * n
  let i = 0
  while i < n { result[i] = buf[i] + wet_sum[i] / ncombs * mix; i = i + 1 }
  return result
}

# ---- synthesis helpers ----

fn noise() { return rng.random() * 2 - 1 }

# Exponential decay envelope: 1.0 at t=0, decays toward 0 by `decay_rate`
# (higher = faster). t in seconds.
fn envelope_exp(t, decay_rate) { return _exp(-t * decay_rate) }

# Linear-interpolation resampling - the honest way to actually change a
# buffer's sample rate, not just relabel it in a WAV header (which
# changes playback speed/pitch instead). Not sinc-quality, but real: each
# output sample is a true interpolated value between its two nearest
# input samples, not a nearest-neighbor guess.
fn resample(samples, from_rate, to_rate) {
  if from_rate == to_rate { return list(samples) }
  let in_n = len(samples)
  let out_n = int(in_n * to_rate / float(from_rate))
  let ratio = from_rate / float(to_rate)
  let out = []
  let i = 0
  while i < out_n {
    let src_pos = i * ratio
    let idx0 = int(src_pos)
    let frac = src_pos - idx0
    let s0 = idx0 < in_n ? samples[idx0] : 0.0
    let s1 = (idx0 + 1) < in_n ? samples[idx0 + 1] : s0
    out.push(s0 + (s1 - s0) * frac)
    i = i + 1
  }
  return out
}

# ---- integrated loudness metering (larzscript-beatstudio PLAN5.md Phase
# N) - approximates the ITU-R BS.1770 measurement real streaming
# platforms (Spotify/YouTube/Apple Music) target, NOT a certified/
# bit-exact implementation. Real K-weighting is two precise filter
# stages plus a 2-stage RELATIVE gate excluding quiet passages from the
# measurement; this uses the SAME biquad_shelf_new already in this
# package to approximate the two K-weighting stages that matter
# perceptually (a low-end rolloff + a high-frequency presence boost) and
# a simple ABSOLUTE silence gate instead of the real relative one. Close
# enough to be a genuinely useful loudness target, not represented as
# certified-compliant anywhere in this codebase or its UI. ----

fn lufs_new(sample_rate) {
  return {
    "hp_l": biquad_shelf_new(60, -8.0, sample_rate, false),
    "hp_r": biquad_shelf_new(60, -8.0, sample_rate, false),
    "hf_l": biquad_shelf_new(1500, 4.0, sample_rate, true),
    "hf_r": biquad_shelf_new(1500, 4.0, sample_rate, true),
    "sum_sq": 0.0, "count": 0.0,
  }
}

# Silence gate threshold - samples quieter than this don't count toward
# the measurement, a simplified stand-in for BS.1770's real relative
# gate (which excludes passages quiet RELATIVE to the track's own
# ungated loudness - this uses one fixed absolute threshold instead).
let _LUFS_GATE = 0.00003162  # -90 dBFS

fn lufs_process_buffer(state, l, r) {
  let lw = biquad_process_buffer(state["hp_l"], l)
  lw = biquad_process_buffer(state["hf_l"], lw)
  let rw = biquad_process_buffer(state["hp_r"], r)
  rw = biquad_process_buffer(state["hf_r"], rw)
  let i = 0
  while i < len(lw) {
    let lv = lw[i]
    let rv = rw[i]
    if (lv > _LUFS_GATE or lv < -_LUFS_GATE) {
      state["sum_sq"] = state["sum_sq"] + lv * lv
      state["count"] = state["count"] + 1.0
    }
    if (rv > _LUFS_GATE or rv < -_LUFS_GATE) {
      state["sum_sq"] = state["sum_sq"] + rv * rv
      state["count"] = state["count"] + 1.0
    }
    i = i + 1
  }
}

# -0.691 + 10*log10(mean square) is the real ITU-R BS.1770 formula -
# 10*log10(x) = linear_to_db(sqrt(x)) since linear_to_db is 20*log10 and
# sqrt halves the exponent, so this reuses linear_to_db exactly rather
# than needing a separate log10 helper.
fn lufs_result(state) {
  if state["count"] <= 0.0 { return -70.0 }
  let mean_sq = state["sum_sq"] / state["count"]
  if mean_sq <= 0.0 { return -70.0 }
  return -0.691 + linear_to_db(sqrt(mean_sq))
}
