# session - signed cookie sessions: pack a data dict into a
# base64(JSON) + HMAC-SHA256 signature cookie value, and verify it back.
# There is no server-side session store here - the cookie itself IS the
# session, integrity-protected by the signature so a client can't forge
# or silently tamper with it (they just can't see a store's worth of
# extra data either - only what you put in the cookie).
#
#   import "session" as session
#   let cookie = session.create({"user_id": 42}, "app-secret")
#   let data = session.verify(cookie, "app-secret")
#   print(data["user_id"])                       # 42
#   let tampered = cookie[0:len(cookie)-1] + "X"
#   print(session.verify(tampered, "app-secret")) # nil

import "json" as json
import "base64" as b64
import "crypto" as crypto
import "uuid" as uuid

fn create(data, secret) {
  let payload = b64.encode(json.stringify(data))
  let sig = crypto.hmac(secret, payload)
  return payload + "." + sig
}

# Constant-time-ish comparison: always walks the full length of the
# longer string instead of returning on the first mismatch, so a
# timing attack can't learn the signature one byte at a time.
fn _secure_equal(a, b) {
  let n = len(a) > len(b) ? len(a) : len(b)
  let diff = len(a) != len(b) ? 1 : 0
  let i = 0
  while i < n {
    let ca = i < len(a) ? a[i:i+1] : ""
    let cb = i < len(b) ? b[i:i+1] : ""
    if ca != cb { diff = 1 }
    i = i + 1
  }
  return diff == 0
}

fn verify(cookie_value, secret) {
  let dot = cookie_value.find(".")
  if dot < 0 { return nil }
  let payload = cookie_value[0:dot]
  let sig = cookie_value[dot+1:]
  let expected = crypto.hmac(secret, payload)
  if not _secure_equal(sig, expected) { return nil }
  return json.parse(b64.decode(payload))
}

fn csrf_token(secret, session_id) {
  let nonce = uuid.v4()
  let sig = crypto.hmac(secret, session_id + ":" + nonce)
  return nonce + "." + sig
}

fn csrf_verify(token, secret, session_id) {
  let dot = token.find(".")
  if dot < 0 { return false }
  let nonce = token[0:dot]
  let sig = token[dot+1:]
  return _secure_equal(sig, crypto.hmac(secret, session_id + ":" + nonce))
}
