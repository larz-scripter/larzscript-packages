# time - time and duration helpers (built on the time()/clock()/date()/
# datetime() builtins).
#
#   import "time" as time
#   let start = time.stopwatch(); ...; print(time.elapsed(start))
#   print(time.humanize(93784))     # "1d 2h 3m 4s"
#   print(time.today())             # "2026-08-01" (UTC)
#   print(time.now_iso())           # "2026-08-01T17:33:21Z" (UTC)

fn now() { return time() }
fn stopwatch() { return clock() }
fn elapsed(start) { return clock() - start }
# Pure, portable epoch->calendar (UTC, no shell-out) - kernel-portable, unlike
# format() below. today()/now_iso() default to the current time.
fn today(ts=nil) { return ts == nil ? date() : date(ts) }
fn now_iso(ts=nil) { return ts == nil ? datetime() : datetime(ts) }

fn humanize(secs) {
  let s = int(secs)
  if s < 0 { return "-" + humanize(-s) }
  let parts = []
  let d = s // 86400
  if d > 0 { parts.push(str(d) + "d"); s = s % 86400 }
  let h = s // 3600
  if h > 0 { parts.push(str(h) + "h"); s = s % 3600 }
  let m = s // 60
  if m > 0 { parts.push(str(m) + "m"); s = s % 60 }
  if s > 0 or len(parts) == 0 { parts.push(str(s) + "s") }
  return join(parts, " ")
}

fn _q(s) { return "'" + str(s).replace("'", "'\\''") + "'" }
# Format a unix timestamp using the system `date` (strftime-style format,
# hosted-only - shells out, needs a real `date` binary; use today()/now_iso()
# above for a portable, kernel-safe fixed format instead).
fn format(ts, fmt) { return capture("date -d @" + str(int(ts)) + " +" + _q(fmt)).strip() }
