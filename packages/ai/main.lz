# ai - call any OpenAI-compatible chat completion endpoint, in pure
# Larzscript. Built on the json package for parsing/encoding. Doesn't use
# the http package's post_headers() on purpose: it shells out with
# `curl -f`, which discards the response body on any 4xx/5xx status - and
# OpenAI-compatible APIs put the actually-useful error message in that
# body (see the "endpoint returned an error" path below), so this needs
# the body regardless of status code. Uses the same proven single-quote
# shell-escaping http.lz's own _q() uses (wrap in quotes, close/escape/
# reopen for any embedded quote) rather than depending on that package's
# private helper.
#
# No endpoint, model or key is ever hardcoded - configure via environment
# variables so this works with any real OpenAI-compatible backend (the
# real OpenAI API, Azure OpenAI, a self-hosted gateway, local Ollama via
# an OpenAI-compatible shim, ...), not one estate's private infrastructure:
#   LARZSCRIPT_AI_ENDPOINT   full URL to a /v1/chat/completions-style route
#   LARZSCRIPT_AI_MODEL      model name your endpoint expects
#   LARZSCRIPT_AI_KEY        optional - sent as "Authorization: Bearer ..."
#                            when set; omit for an endpoint that needs none
#
#   import "ai" as ai
#   let answer = ai.ask("What is 2 + 2? Answer with just the number.")
#   print(answer)
#
# ask_with(prompt, endpoint, model, key) skips the environment entirely,
# for a script that talks to more than one endpoint or shouldn't read env.
#
# Errors raise AiError with a clear message: missing config, no response,
# an endpoint-reported error (with the endpoint's own real message), or a
# response shape ask() doesn't recognize (never a silent empty string).

import "json" as json

fn _q(s) { return "'" + str(s).replace("'", "'\\''") + "'" }

fn ask(prompt) {
  return ask_with(prompt, env("LARZSCRIPT_AI_ENDPOINT"), env("LARZSCRIPT_AI_MODEL"), env("LARZSCRIPT_AI_KEY"))
}

fn ask_with(prompt, endpoint, model, key) {
  if endpoint == nil or endpoint == "" {
    throw {"type": "AiError", "message": "no endpoint configured - set LARZSCRIPT_AI_ENDPOINT (a /v1/chat/completions-style URL) or pass one to ask_with()"}
  }
  if model == nil or model == "" {
    throw {"type": "AiError", "message": "no model configured - set LARZSCRIPT_AI_MODEL or pass one to ask_with()"}
  }

  let body = json.stringify({"model": model, "messages": [{"role": "user", "content": prompt}]})
  let auth_flag = ""
  if key != nil and key != "" { auth_flag = " -H " + _q("Authorization: Bearer " + key) }

  let cmd = "curl -sS -X POST " + _q(endpoint) + " -H " + _q("Content-Type: application/json") + auth_flag + " --data " + _q(body)
  let out = capture(cmd)

  if out == nil or out.strip() == "" {
    throw {"type": "AiError", "message": "no response from endpoint (curl produced no output) - check LARZSCRIPT_AI_ENDPOINT and network access"}
  }

  let data = json.parse(out)

  let err_msg = json.get(data, "error.message", nil)
  if err_msg != nil {
    throw {"type": "AiError", "message": "endpoint returned an error: " + err_msg}
  }

  let choices = json.get(data, "choices", nil)
  if choices == nil or len(choices) == 0 {
    throw {"type": "AiError", "message": "unrecognized response shape (no .choices) from endpoint: " + out}
  }

  let content = json.get(choices[0], "message.content", nil)
  if content == nil {
    throw {"type": "AiError", "message": "unrecognized response shape (no .choices[0].message.content) from endpoint: " + out}
  }
  return content
}
