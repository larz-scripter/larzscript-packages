  "SAR": {"exp": 2, "sym": "﷼", "name": "Saudi Riyal"},
  "QAR": {"exp": 2, "sym": "﷼", "name": "Qatari Rial"},
  "ILS": {"exp": 2, "sym": "₪", "name": "New Israeli Sheqel"},
  "KRW": {"exp": 0, "sym": "₩", "name": "Won"},
  "THB": {"exp": 2, "sym": "฿", "name": "Baht"},
  "IDR": {"exp": 2, "sym": "Rp", "name": "Rupiah"},
  "MYR": {"exp": 2, "sym": "RM", "name": "Malaysian Ringgit"},
  "PHP": {"exp": 2, "sym": "₱", "name": "Philippine Peso"},
  "VND": {"exp": 0, "sym": "₫", "name": "Dong"},
  "PKR": {"exp": 2, "sym": "₨", "name": "Pakistan Rupee"},
  "BDT": {"exp": 2, "sym": "৳", "name": "Taka"},
  "BHD": {"exp": 3, "sym": ".د.ب", "name": "Bahraini Dinar"},
  "KWD": {"exp": 3, "sym": "د.ك", "name": "Kuwaiti Dinar"},
  "OMR": {"exp": 3, "sym": "ر.ع.", "name": "Rial Omani"},
