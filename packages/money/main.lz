# money - exact, multi-currency money: an integer count of minor units
# (cents) plus a currency, never a value that silently drifted through
# float arithmetic. Seven rounding modes (HALF_UP/HALF_EVEN/HALF_DOWN/
# UP/DOWN/CEILING/FLOOR), split()/allocate() that always reconcile to
# the exact original (no cent created or lost), a curated ISO-4217
# registry plus register() for custom currencies (crypto, points
# systems, testnets), and an exchange-rate table for conversion at an
# explicit rate you supply (this package never fetches rates itself).
#
# Honest limitation: Larzscript's only numeric type is a double (no
# arbitrary-precision decimal the way Python's `decimal` module gives
# the original larzmoney), so amounts here are float-precision, same as
# every other money-shaped package in this stack (`cart`, `tax`,
# `ledger`). Fine for real-world amounts; not a bignum ledger.
#
#   import "money" as money
#   let m = money.of("10.99", "USD")
#   print(money.format(m))                          # "$10.99"
#   print(money.format(money.percent(money.of("10.00", "USD"), "8.25")))  # sales tax
#   print(money.split(money.of("100.00", "USD"), 3))  # no cent is lost
#   let fx = money.exchange_new("USD")
#   money.exchange_add(fx, "EUR", "0.92")
#   print(money.format(money.exchange_convert(fx, money.of("100", "USD"), "EUR")))

# ---- currency registry ----

let _TABLE = {
  "USD": {"exp": 2, "sym": "$", "name": "US Dollar"},
  "EUR": {"exp": 2, "sym": "€", "name": "Euro"},
  "GBP": {"exp": 2, "sym": "£", "name": "Pound Sterling"},
  "JPY": {"exp": 0, "sym": "¥", "name": "Yen"},
  "CNY": {"exp": 2, "sym": "¥", "name": "Yuan Renminbi"},
  "CHF": {"exp": 2, "sym": "CHF", "name": "Swiss Franc"},
  "CAD": {"exp": 2, "sym": "$", "name": "Canadian Dollar"},
  "AUD": {"exp": 2, "sym": "$", "name": "Australian Dollar"},
  "NZD": {"exp": 2, "sym": "$", "name": "New Zealand Dollar"},
  "HKD": {"exp": 2, "sym": "$", "name": "Hong Kong Dollar"},
