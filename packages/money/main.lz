  "BRL": {"exp": 2, "sym": "R$", "name": "Brazilian Real"},
  "MXN": {"exp": 2, "sym": "$", "name": "Mexican Peso"},
  "ARS": {"exp": 2, "sym": "$", "name": "Argentine Peso"},
  "CLP": {"exp": 0, "sym": "$", "name": "Chilean Peso"},
  "COP": {"exp": 2, "sym": "$", "name": "Colombian Peso"},
  "RUB": {"exp": 2, "sym": "₽", "name": "Russian Ruble"},
  "TRY": {"exp": 2, "sym": "₺", "name": "Turkish Lira"},
  "PLN": {"exp": 2, "sym": "zł", "name": "Zloty"},
  "SEK": {"exp": 2, "sym": "kr", "name": "Swedish Krona"},
  "NOK": {"exp": 2, "sym": "kr", "name": "Norwegian Krone"},
  "DKK": {"exp": 2, "sym": "kr", "name": "Danish Krone"},
  "CZK": {"exp": 2, "sym": "Kč", "name": "Czech Koruna"},
  "HUF": {"exp": 2, "sym": "Ft", "name": "Forint"},
  "RON": {"exp": 2, "sym": "lei", "name": "Romanian Leu"},
