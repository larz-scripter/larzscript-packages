# password_setup_windows.lz - same idea as password_setup.lz (fill in 4
# lines, run it, done) but targets Windows' own built-in OpenSSH Server
# instead of a Linux sshd. Point of this: no WSL networking to fight -
# WSL's sshd lives behind its own virtual network adapter, which is a
# common source of "the tunnel connects but times out" - native Windows
# doesn't have that problem, so this exposes native Windows instead.
#
# Requires Windows 10 1809+ / Windows 11 (ships the OpenSSH *client*
# already). The OpenSSH *server* piece gets installed by this script if
# missing - needs ONE run from an elevated ("Run as Administrator")
# PowerShell or cmd for that; every run after is normal.
#
#   larzscript pkg install netbridge
#   larzscript password_setup_windows.lz
#
# NOTE: I don't have a Windows machine to run this on, so this is
# written correctly against documented Windows/OpenSSH behavior but not
# verified end-to-end the way the Linux version was (that one was rerun
# against a real VPS three times before publishing). Run it and tell me
# what it prints - especially the sshd step and the final PASS/FAIL.

import "netbridge" as netbridge

# ---- fill these in ----
let RELAY_HOST = "203.0.113.10"
let RELAY_SSH_PORT = 22
let RELAY_ROOT_USER = "root"
let RELAY_ROOT_PASSWORD = "change-me"
let TUNNEL_PORT = 2200
# ------------------------

let HOME = env("USERPROFILE", "C:\\Users\\Default")
let KEY_PATH = HOME + "\\.ssh\\netbridge_key"

fn step(msg) { print("==> " + msg) }

# ---- 1. Windows' own OpenSSH Server - installs/starts it if it isn't already ----
step("Windows OpenSSH Server")
let sshd_status = capture("powershell -NoProfile -Command \"(Get-Service sshd -ErrorAction SilentlyContinue).Status\"").strip()
if sshd_status != "Running" {
  print("sshd is " + (sshd_status == "" ? "not installed" : sshd_status) + " - installing/starting (needs Administrator) ...")
  run("powershell -NoProfile -Command \"Add-WindowsCapability -Online -Name OpenSSH.Server~~~~0.0.1.0 | Out-Null; Set-Service -Name sshd -StartupType Automatic; Start-Service sshd\"")
  sshd_status = capture("powershell -NoProfile -Command \"(Get-Service sshd -ErrorAction SilentlyContinue).Status\"").strip()
  if sshd_status != "Running" {
    print("FAIL: sshd did not start - re-run this script from an elevated (Administrator) PowerShell/cmd, then try again.")
    exit(1)
  }
}
print("sshd is running")

# ---- 2. client key ----
step("client key")
if not file_exists(KEY_PATH) {
  run("mkdir \"" + HOME + "\\.ssh\" 2>nul")
  run("ssh-keygen -t ed25519 -f \"" + KEY_PATH + "\" -N \"\" -C netbridge-windows -q")
  print("generated " + KEY_PATH)
} else {
  print("already have " + KEY_PATH)
}
let pubkey = read_file(KEY_PATH + ".pub").strip()

# ---- 3. one-time relay setup, authenticated with your password ----
# Windows' bundled ssh.exe has no non-interactive password mode (no
# sshpass build for Windows) - if WSL is installed, this borrows WSL's
# sshpass for this ONE line only (same trusted setup script as the Linux
# version, just reached through WSL as a transport). sshd + the actual
# tunnel below are 100% native Windows either way. No WSL? It prints the
# same setup script for you to run by hand, once, from anywhere you can
# already reach the relay as root.
step("setting up the relay (password, one time only)")
let relay_script = "#!/bin/sh\nset -e\n" +
  "TUNNEL_USER=tunnel\n" +
  "PUBKEY='" + pubkey + "'\n" +
  "id -u \"$TUNNEL_USER\" >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin \"$TUNNEL_USER\"\n" +
  "install -d -m 700 -o \"$TUNNEL_USER\" -g \"$TUNNEL_USER\" \"/home/$TUNNEL_USER/.ssh\"\n" +
  "touch \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "chmod 600 \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "chown \"$TUNNEL_USER:$TUNNEL_USER\" \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "grep -qF \"$PUBKEY\" \"/home/$TUNNEL_USER/.ssh/authorized_keys\" 2>/dev/null || " +
  "printf 'no-pty,no-X11-forwarding,no-agent-forwarding,command=\"echo netbridge: no interactive shell\" %s\\n' \"$PUBKEY\" >> \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "echo RELAY_SETUP_OK\n"
let relay_script_path = env("TEMP", "C:\\Windows\\Temp") + "\\_netbridge_relay_setup.sh"
write_file(relay_script_path, relay_script)

let has_wsl = capture("where wsl 2>nul").strip() != ""
let relay_out = ""
if has_wsl {
  let wsl_script_path = capture("wsl wslpath -u \"" + relay_script_path + "\"").strip()
  relay_out = capture("wsl sshpass -p '" + RELAY_ROOT_PASSWORD.replace("'", "'\\''") +
    "' ssh -o StrictHostKeyChecking=accept-new -o PreferredAuthentications=password -p " +
    str(RELAY_SSH_PORT) + " " + RELAY_ROOT_USER + "@" + RELAY_HOST + " 'bash -s' < " + wsl_script_path)
  print(relay_out)
  if not relay_out.contains("RELAY_SETUP_OK") {
    print("FAIL: relay setup via WSL didn't confirm - check RELAY_HOST/RELAY_SSH_PORT/RELAY_ROOT_PASSWORD, and that WSL has `sshpass` (wsl sudo apt install -y sshpass).")
    exit(1)
  }
} else {
  print("no WSL found on PATH - run this once, by hand, against the relay as root, then re-run this script:")
  print("")
  print("  ssh -p " + str(RELAY_SSH_PORT) + " " + RELAY_ROOT_USER + "@" + RELAY_HOST + " 'bash -s' < " + relay_script_path)
  print("")
  print("(that file is sitting at " + relay_script_path + " - it's the exact same idempotent setup script the Linux version runs)")
  exit(1)
}

# ---- 4. connect - stays up, auto-reconnects with backoff ----
step("connecting (auto-reconnects if the relay or network hiccups)")
let srv = netbridge.default_server()
srv["host"] = RELAY_HOST
srv["port"] = RELAY_SSH_PORT
srv["user"] = "tunnel"
srv["identity"] = KEY_PATH
srv["known_hosts"] = HOME + "\\.ssh\\known_hosts"
let shell = netbridge.tunnel_forward("my-shell", TUNNEL_PORT, "127.0.0.1", 22)
print(netbridge.route_label(shell))

netbridge.supervise(srv, shell, {
  "log_fn": fn(name, line) { print("[" + name + "] " + line) },
})
