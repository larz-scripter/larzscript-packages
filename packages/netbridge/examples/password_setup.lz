# netbridge_password_setup.lz - fill in your relay's details below, run
# it. It generates its own client key, uses your root password ONCE to
# set up a locked-down tunnel user on the relay (nothing else, no shell
# access - see the relay script below), then connects and stays
# connected with auto-reconnect. The password is never needed again
# after this one run - everything after setup uses the key it generated.
#
# Needs `sshpass` on this machine (apt install sshpass / brew install
# sshpass) - that's the one dependency, for the one-time password step.
#
#   larzscript pkg install netbridge
#   nohup larzscript netbridge_password_setup.lz > ~/netbridge.log 2>&1 &

import "netbridge" as netbridge

# ---- fill these in ----
let RELAY_HOST = "203.0.113.10"          # your relay's address or IP
let RELAY_SSH_PORT = 22                   # whatever port sshd listens on there
let RELAY_ROOT_USER = "root"
let RELAY_ROOT_PASSWORD = "change-me"     # only used once, for setup
let TUNNEL_PORT = 2200                    # the port on the relay that will reach this machine
# ------------------------

let KEY_PATH = env("HOME", ".") + "/.ssh/netbridge_key"

fn step(msg) { print("==> " + msg) }
fn shq(s) { return "'" + s.replace("'", "'\\''") + "'" }

# ---- 1. client key - generated fresh here, unique per machine ----
step("client key")
if not file_exists(KEY_PATH) {
  run("ssh-keygen -t ed25519 -f " + KEY_PATH + " -N '' -C netbridge-client -q")
  print("generated " + KEY_PATH)
} else {
  print("already have " + KEY_PATH)
}
let pubkey = read_file(KEY_PATH + ".pub").strip()

# ---- 2. one-time relay setup, authenticated with your password ----
step("setting up the relay (password, one time only)")
let relay_script = "#!/bin/sh\nset -e\n" +
  "TUNNEL_USER=tunnel\n" +
  "PUBKEY='" + pubkey + "'\n" +
  "id -u \"$TUNNEL_USER\" >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin \"$TUNNEL_USER\"\n" +
  "install -d -m 700 -o \"$TUNNEL_USER\" -g \"$TUNNEL_USER\" \"/home/$TUNNEL_USER/.ssh\"\n" +
  "touch \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "chmod 600 \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "chown \"$TUNNEL_USER:$TUNNEL_USER\" \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "grep -qF \"$PUBKEY\" \"/home/$TUNNEL_USER/.ssh/authorized_keys\" 2>/dev/null || " +
  "printf 'no-pty,no-X11-forwarding,no-agent-forwarding,command=\"echo netbridge: no interactive shell\" %s\\n' \"$PUBKEY\" >> \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "pid=$(ss -tlnp 2>/dev/null | grep :" + str(TUNNEL_PORT) + " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2); [ -n \"$pid\" ] && kill \"$pid\" 2>/dev/null; true\n" +
  "echo RELAY_SETUP_OK\n"
let relay_script_path = "/tmp/_netbridge_relay_setup.sh"
write_file(relay_script_path, relay_script)

let ssh_pw_cmd = "sshpass -p " + shq(RELAY_ROOT_PASSWORD) +
  " ssh -o StrictHostKeyChecking=accept-new -o PreferredAuthentications=password" +
  " -p " + str(RELAY_SSH_PORT) + " " + RELAY_ROOT_USER + "@" + RELAY_HOST +
  " 'bash -s' < " + relay_script_path
let relay_out = capture(ssh_pw_cmd)
print(relay_out)
if not relay_out.contains("RELAY_SETUP_OK") {
  print("FAIL: could not set up the relay - check RELAY_HOST / RELAY_SSH_PORT / RELAY_ROOT_PASSWORD, and that `sshpass` is installed.")
  exit(1)
}

# ---- 3. connect - stays up, auto-reconnects with backoff ----
step("connecting (auto-reconnects if the relay or network hiccups)")
let srv = netbridge.default_server()
srv["host"] = RELAY_HOST
srv["port"] = RELAY_SSH_PORT
srv["user"] = "tunnel"
srv["identity"] = KEY_PATH
srv["known_hosts"] = env("HOME", ".") + "/.ssh/known_hosts"
let shell = netbridge.tunnel_forward("my-shell", TUNNEL_PORT, "127.0.0.1", 22)
print(netbridge.route_label(shell))

netbridge.supervise(srv, shell, {
  "log_fn": fn(name, line) { print("[" + name + "] " + line) },
})
