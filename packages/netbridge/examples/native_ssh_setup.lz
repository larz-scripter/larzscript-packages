# native_ssh_setup.lz - ONE script, same file, for Linux, macOS, AND
# Windows - fill in 6 lines, run it, done, on whichever of the three
# you're on. Uses the `ssh` package (real SSH via libssh, bound into
# the interpreter itself) for EVERYTHING - the one-time
# password-authenticated relay setup AND the tunnel connection both go
# through ssh.connect()/ssh.run()/ssh.forward_remote_port(). No
# shelling out to the `ssh` binary, no `sshpass` dependency, no WSL, no
# per-OS variant to maintain - nothing external at all beyond
# `larzscript` and two Stack packages, on any of the three.
#
# Needs the `ssh` package's native libssh binding, which - as of this
# writing - covers exactly those three: Linux x86_64, macOS (x86_64 +
# arm64), and Windows x86_64, all CI-verified against a real independent
# sshd/ssh client (see `ssh`'s own README for exact platform status;
# every other platform throws a clear SshError). Not on one of those
# three yet (Linux aarch64, wasm)? Use password_setup.lz instead
# (shells to the real `ssh`/`sshpass` binaries, works everywhere those
# do, just needs those installed).
#
#   larzscript pkg install netbridge
#   larzscript pkg install ssh
#   nohup larzscript native_ssh_setup.lz > ~/netbridge.log 2>&1 &
#   (on Windows: just `larzscript native_ssh_setup.lz`, no nohup/&)

import "ssh" as ssh

# ---- fill these in ----
let RELAY_HOST = "203.0.113.10"          # your relay's address or IP
let RELAY_SSH_PORT = 22                   # whatever port sshd listens on there
let RELAY_ROOT_USER = "root"
let RELAY_ROOT_PASSWORD = "change-me"     # only used once, for setup
let TUNNEL_PORT = 2200                    # the port on the relay that will reach this machine
let TARGET_HOST = "127.0.0.1"             # the local service to expose...
let TARGET_PORT = 22                      # ...and its port (e.g. 3389 for Windows RDP)
# ------------------------

# HOME isn't set by default in plain cmd/PowerShell - USERPROFILE is
# Windows' equivalent. Forward slashes work fine in paths passed to
# larzscript's own file/ssh-keygen calls on all three platforms.
let KEY_PATH = env("HOME", env("USERPROFILE", ".")) + "/.ssh/netbridge_key"

fn step(msg) { print("==> " + msg) }

# ---- 1. client key - generated fresh here, unique per machine ----
# Double-quoted path + double-quoted empty passphrase (-N "") rather
# than single quotes: `run()` shells out via the OS's own shell
# (/bin/sh on Linux/macOS, cmd.exe on Windows) - single-quote emptiness
# is a POSIX-only convention (cmd.exe treats '' as two literal
# characters, not nothing), but "" for an empty argument, and double
# quotes around a path that might contain spaces, both work identically
# on all three - the one quoting style that needed no per-OS branch.
step("client key")
if not file_exists(KEY_PATH) {
  run("ssh-keygen -t ed25519 -f \"" + KEY_PATH + "\" -N \"\" -C netbridge-client -q")
  print("generated " + KEY_PATH)
} else {
  print("already have " + KEY_PATH)
}
let pubkey = read_file(KEY_PATH + ".pub").strip()

# ---- 2. one-time relay setup, authenticated with your password - via
# ssh.run(), not a shelled-out `sshpass ssh ...` command ----
step("setting up the relay (password, one time only, via ssh.run())")
let relay_script = "#!/bin/sh\nset -e\n" +
  "TUNNEL_USER=tunnel\n" +
  "PUBKEY='" + pubkey + "'\n" +
  "id -u \"$TUNNEL_USER\" >/dev/null 2>&1 || useradd -m -s /usr/sbin/nologin \"$TUNNEL_USER\"\n" +
  "install -d -m 700 -o \"$TUNNEL_USER\" -g \"$TUNNEL_USER\" \"/home/$TUNNEL_USER/.ssh\"\n" +
  "touch \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "chmod 600 \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "chown \"$TUNNEL_USER:$TUNNEL_USER\" \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "grep -qF \"$PUBKEY\" \"/home/$TUNNEL_USER/.ssh/authorized_keys\" 2>/dev/null || " +
  "printf 'no-pty,no-X11-forwarding,no-agent-forwarding,command=\"echo netbridge: no interactive shell\" %s\\n' \"$PUBKEY\" >> \"/home/$TUNNEL_USER/.ssh/authorized_keys\"\n" +
  "echo RELAY_SETUP_OK\n"

let setup_session = ssh.connect(RELAY_HOST, RELAY_SSH_PORT)
ssh.authenticate_with_password(setup_session, RELAY_ROOT_USER, RELAY_ROOT_PASSWORD)
let setup_result = ssh.run(setup_session, relay_script)
print(setup_result["stdout"])
if not setup_result["stdout"].contains("RELAY_SETUP_OK") {
  print("FAIL: could not set up the relay - check RELAY_HOST/RELAY_SSH_PORT/RELAY_ROOT_PASSWORD.")
  print(setup_result["stderr"])
  exit(1)
}
ssh.disconnect(setup_session)

# ---- 3. connect - real ssh -R forwarding, stays up ----
step("connecting (real ssh -R through libssh - no external ssh process)")
let session = ssh.connect(RELAY_HOST, RELAY_SSH_PORT)
ssh.authenticate_with_key(session, "tunnel", KEY_PATH)
print("relay:" + str(TUNNEL_PORT) + "  ->  " + TARGET_HOST + ":" + str(TARGET_PORT))
ssh.forward_remote_port(session, TUNNEL_PORT, TARGET_HOST, TARGET_PORT)
